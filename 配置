# mihomo 精简配置

# 锚点
proxy: &proxy { type: select, include-all: true, exclude-type: dns, exclude-filter: "剩余|流量|到期|套餐|官网|推广|重置|订阅|小时|建议|机场|Traffic|Expired", proxies: [🐱主代理, 🌐全球直连] }
direct: &direct { type: select, include-all: true, exclude-type: dns, exclude-filter: "剩余|流量|到期|套餐|官网|推广|重置|订阅|小时|建议|机场|Traffic|Expired", proxies: [🌐全球直连, 🐱主代理] }
ipcidr_mrs: &ipcidr_mrs { type: http, interval: 432000, behavior: ipcidr, format: mrs, proxy: 🌐全球直连 } # 5 天更新
domain_mrs: &domain_mrs { type: http, interval: 432000, behavior: domain, format: mrs, proxy: 🌐全球直连 } # 5 天更新

p: &p
  type: http
  size-limit: 0
  header:
    User-Agent:
      - meta;clash.meta;Clash/v1.18.0;clash
  health-check:
    enable: true
    url: https://www.gstatic.com/generate_204
    timeout: 5000
    lazy: true
# 节点统一覆写：关闭额外 TCP 特性，降低 Android 功耗并保持兼容性
override: &override
  tfo: false
  mptcp: false
  udp: true
  udp-over-tcp: false
  skip-cert-verify: true
  ip-version: dual


# ---------------- 订阅 ----------------
proxy-providers:
  provider1:
    <<: *p
    url: 订阅链接1
    path: ./proxies/provider1.yaml
    override:
      <<: *override
      additional-suffix: ' 机场名字'

#  provider2:
#    <<: *p
#    url: 订阅链接2
#    path: ./proxies/provider2.yaml
#    override:
#      <<: *override
#      additional-suffix: ' 机场名字'

# 基础设置
mixed-port: 7890
allow-lan: false
mode: rule
log-level: warning
ipv6: true
unified-delay: true
tcp-concurrent: true
etag-support: true
find-process-mode: strict # PROCESS-NAME 根据包名分流所需

geodata-mode: false # 未使用 GEOIP/GEOSITE 轻量化
geodata-loader: memconservative
geo-auto-update: false

# FCM 推送长连接保障
disable-keep-alive: false
keep-alive-idle: 420 # 小于 GMS 心跳上限 590s
keep-alive-interval: 50

# DoH 服务器固定解析
hosts:
  dns.alidns.com:
    - 223.5.5.5
    - 223.6.6.6
  dns.google:
    - 8.8.4.4
    - 8.8.8.8

profile:
  store-selected: true
  store-fake-ip: true

dns:
  enable: true
  cache-algorithm: arc
  prefer-h3: true
  use-hosts: true
  respect-rules: false
  ipv6: true
  default-nameserver:
    - 223.5.5.5
    - 223.6.6.6
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter: # 真实解析白名单
    - "+.lan"
    - "+.local"
    - "+.localdomain"
    - "+.home.arpa"
    - "+.localhost"
    - "mtalk.google.com"
    - "mtalk4.google.com"
    - "mtalk-staging.google.com"
    - "mtalk-dev.google.com"
    - "alt1-mtalk.google.com"
    - "alt2-mtalk.google.com"
    - "alt3-mtalk.google.com"
    - "alt4-mtalk.google.com"
    - "alt5-mtalk.google.com"
    - "alt6-mtalk.google.com"
    - "alt7-mtalk.google.com"
    - "alt8-mtalk.google.com"

  nameserver-policy:
    "RULE-SET:private_domain,cn_domain":
      - "https://dns.alidns.com/dns-query#🌐全球直连"
      - "https://doh.pub/dns-query#🌐全球直连"
    "DOMAIN-SUFFIX:cc":
      - "https://dns.alidns.com/dns-query#🌐全球直连"
      - "https://doh.pub/dns-query#🌐全球直连"
    "geosite:googlefcm":
      - "https://dns.google/dns-query#🐱主代理"
    "geosite:google":
      - "https://dns.google/dns-query#🐱主代理"

  nameserver:
    - "https://dns.alidns.com/dns-query#🌐全球直连"
    - "https://doh.pub/dns-query#🌐全球直连"

  proxy-server-nameserver:
    - "https://dns.alidns.com/dns-query#🌐全球直连"

  direct-nameserver:
    - "https://dns.alidns.com/dns-query#🌐全球直连"
    - "https://doh.pub/dns-query#🌐全球直连"

# TUN
tun:
  enable: true
  stack: system # 省内存省 CPU
  auto-route: true
  auto-detect-interface: true
  strict-route: true # Android TUN 防止 DNS/流量绕过
  mtu: 1400
  dns-hijack:
    - any:53
    - tcp://any:53
  udp-timeout: 300 # 兼顾 FCM/UDP 稳定与功耗

# 嗅探
sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: false
  override-destination: false
  sniff:
    HTTP: { ports: [80, 8080-8880], override-destination: true }
    TLS: { ports: [443, 8443] }

proxies:
  - name: "DNS劫持"
    type: dns

# 分组
proxy-groups:
  # 主代理（总入口）
  - { name: 🐱主代理, type: select, include-all: true, exclude-type: dns, exclude-filter: "剩余|流量|到期|套餐|官网|推广|重置|订阅|小时|建议|机场|Traffic|Expired" }

  # FCM 推送
  - { name: 🔔FCM, <<: *proxy }

  # 直连与拦截功能组
  - { name: 🏠全局直连, type: select, hidden: true, proxies: [DIRECT] }
  - { name: 🚫拒绝连接, type: select, hidden: true, proxies: [REJECT] }
  - { name: 🔇静默拒绝, type: select, hidden: true, proxies: [REJECT-DROP] }
  - { name: ⏭️绕过连接, type: select, hidden: true, proxies: [PASS] }
  - { name: 🧹广告拦截, type: select, proxies: [🚫拒绝连接, 🔇静默拒绝, ⏭️绕过连接] }
  - { name: 🧯HttpDNS, type: select, proxies: [🚫拒绝连接, 🔇静默拒绝, ⏭️绕过连接] }
  - { name: 🩹泄漏拦截, type: select, proxies: [🚫拒绝连接, 🔇静默拒绝, ⏭️绕过连接] }
  - { name: 🌐全球直连, type: select, proxies: [🏠全局直连] }

  # 节点信息（load-balance 不可手选，纯展示）
  - { name: 🧾节点信息, type: load-balance, include-all: true, exclude-type: dns, filter: "剩余|流量|到期|套餐|官网|推广|重置|订阅|小时|建议|机场|Traffic|Expired", url: "https://www.gstatic.com/generate_204", interval: 86400, lazy: true }

  # Email
  - { name: 💌Email, <<: *proxy }

  # 应用/网站分流
  - { name: 🐦X, <<: *proxy }
  - { name: 💮ChatGPT, <<: *proxy }
  - { name: 🌌Grok, <<: *proxy }
  - { name: 📸Instagram, <<: *proxy }
  - { name: 🧵Threads, <<: *proxy }
  - { name: 🎨Pixiv, <<: *proxy }
  - { name: 🌈Google, <<: *proxy }
  - { name: 🛩️Telegram, <<: *proxy }
  - { name: ▶️YouTube, <<: *proxy }
  - { name: ♬Spotify, <<: *proxy }
  - { name: 🪩TikTok, <<: *proxy }
  - { name: 🕹️Steam, <<: *proxy }
  - { name: 🍑JMComic, <<: *proxy }
  - { name: 💗PicACG, <<: *proxy }
  - { name: 🌸PCL, <<: *proxy }
  - { name: 🌷EhViewer, <<: *proxy }
  - { name: 🎀DLsite, <<: *proxy }
  - { name: 📺动画疯, <<: *proxy }

# 规则
rules:
  - DST-PORT,53,DNS劫持

  - PROCESS-NAME,com.vivo.email,💌Email
  - SUB-RULE,(OR,((NETWORK,UDP),(NETWORK,TCP))),SUB-RULES
  - MATCH,🐱主代理
  - DOMAIN-SUFFIX,perfectlife.club,🌸PCL
  - DOMAIN-SUFFIX,perfectlife.cc,🌸PCL
  - DOMAIN,mtalk.google.com,DIRECT
  - DOMAIN,mtalk4.google.com,DIRECT
  - DOMAIN,mtalk-staging.google.com,DIRECT
  - DOMAIN,mtalk-dev.google.com,DIRECT
  - DOMAIN,alt1-mtalk.google.com,DIRECT
  - DOMAIN,alt1-mtalk.google.com,DIRECT
  - DOMAIN,alt2-mtalk.google.com,DIRECT
  - DOMAIN,alt3-mtalk.google.com,DIRECT
  - DOMAIN,alt4-mtalk.google.com,DIRECT
  - DOMAIN,alt5-mtalk.google.com,DIRECT
  - DOMAIN,alt6-mtalk.google.com,DIRECT
  - DOMAIN,alt7-mtalk.google.com,DIRECT
  - DOMAIN,alt8-mtalk.google.com,DIRECT
