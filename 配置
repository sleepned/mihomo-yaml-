    - OR,((AND,((NETWORK,TCP),(DST-PORT,5349))),(AND,((NETWORK,UDP),(DST-PORT,5350-5351))),(AND,((NETWORK,UDP),(DST-PORT,19302-19305))),(AND,((NETWORK,UDP),(DST-PORT,19308-19309))),(RULE-SET,stun_domain),(DST-PORT,3478)),🩹泄漏拦截
    - DOMAIN-KEYWORD,stun,🩹泄漏拦截
    # 国际服务（域名）
    - RULE-SET,youtube_domain,▶️YouTube
    - RULE-SET,spotify_domain,♬Spotify
    - OR,((RULE-SET,telegram_domain),(DOMAIN-KEYWORD,nicegram)),🛩️Telegram
    - OR,((RULE-SET,twitter_domain),(DOMAIN-KEYWORD,twitter)),🐦X
    - OR,((RULE-SET,instagram_domain),(DOMAIN-KEYWORD,instagram)),📸Instagram
    - RULE-SET,threads_domain,🧵Threads
    - RULE-SET,pixiv_domain,🎨Pixiv
    - OR,((RULE-SET,steam_domain),(DOMAIN-KEYWORD,steambroadcast),(DOMAIN-KEYWORD,steamstore),(DOMAIN-KEYWORD,steamuserimages)),🕹️Steam
    - OR,((RULE-SET,tiktok_domain),(DOMAIN-KEYWORD,tiktok)),🪩TikTok
    - RULE-SET,18comic_domain,🍑JMComic
    - RULE-SET,picacg_domain,💗PicACG
    - RULE-SET,ehentai_domain,🌷EhViewer
    - RULE-SET,dlsite_domain,🎀DLsite
    - RULE-SET,openai_domain,💮ChatGPT
    - OR,((RULE-SET,xai_domain),(DOMAIN-SUFFIX,grok.com)),🌌Grok
    - RULE-SET,bahamut_domain,📺动画疯
    # 国际服务（IP）
    - RULE-SET,spotify_ip,♬Spotify,no-resolve
    - RULE-SET,telegram_ip,🛩️Telegram,no-resolve
    - RULE-SET,twitter_ip,🐦X,no-resolve
    - RULE-SET,youtube_ip,▶️YouTube,no-resolve
    # 兜底：国内/私有直连
    - OR,((AND,((RULE-SET,cn_domain),(RULE-SET,cn_ip))),(RULE-SET,cn_ip,no-resolve),(RULE-SET,private_ip,no-resolve),(RULE-SET,private_domain)),🌐全球直连

