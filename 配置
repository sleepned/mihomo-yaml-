  SUB-RULES:
    # ① FCM 推送
    - "RULE-SET,googlefcm_domain,🔔FCM"
    - "RULE-SET,googlefcm_ip,🔔FCM,no-resolve"
    - "DOMAIN-SUFFIX,mtalk.google.com,🔔FCM"
    - "DOMAIN-SUFFIX,mtalk4.google.com,🔔FCM"
    - "DOMAIN-SUFFIX,mtalk-staging.google.com,🔔FCM"
    - "DOMAIN-SUFFIX,mtalk-dev.google.com,🔔FCM"
    - "DOMAIN-SUFFIX,alt1-mtalk.google.com,🔔FCM"
    - "DOMAIN-SUFFIX,alt2-mtalk.google.com,🔔FCM"
    - "DOMAIN-SUFFIX,alt3-mtalk.google.com,🔔FCM"
    - "DOMAIN-SUFFIX,alt4-mtalk.google.com,🔔FCM"
    - "DOMAIN-SUFFIX,alt5-mtalk.google.com,🔔FCM"
    - "DOMAIN-SUFFIX,alt6-mtalk.google.com,🔔FCM"
    - "DOMAIN-SUFFIX,alt7-mtalk.google.com,🔔FCM"
    - "DOMAIN-SUFFIX,alt8-mtalk.google.com,🔔FCM"
    # ② Google 相关服务
    - "RULE-SET,google_domain,🌈Google"
    - "DOMAIN-SUFFIX,googleapis.cn,🌐全球直连"
    - "DOMAIN-SUFFIX,gstatic.com,🌈Google"
    - "DOMAIN-SUFFIX,ggpht.com,🌈Google"
    - "DOMAIN-KEYWORD,google,🌈Google"
    - "RULE-SET,google_ip,🌈Google,no-resolve"

    # ③ Email 域名
    - "OR,((DOMAIN-KEYWORD,gmail),(DOMAIN-KEYWORD,outlook),(DOMAIN-KEYWORD,office365),(DOMAIN-SUFFIX,proton.me),(DOMAIN-SUFFIX,protonmail.com),(DOMAIN-SUFFIX,icloud.com),(DOMAIN-SUFFIX,me.com),(DOMAIN-SUFFIX,mac.com),(DOMAIN-KEYWORD,yahoo),(DOMAIN-SUFFIX,aol.com),(DOMAIN-SUFFIX,hotmail.com),(DOMAIN-SUFFIX,live.com),(DOMAIN-SUFFIX,msn.com),(DOMAIN-SUFFIX,gmx.com),(DOMAIN-SUFFIX,gmx.net),(DOMAIN-SUFFIX,web.de),(DOMAIN-SUFFIX,mail.com),(DOMAIN-SUFFIX,mail.ru),(DOMAIN-SUFFIX,yandex.com),(DOMAIN-SUFFIX,yandex.ru),(DOMAIN-SUFFIX,zoho.com),(DOMAIN-SUFFIX,fastmail.com),(DOMAIN-SUFFIX,tuta.com),(DOMAIN-SUFFIX,tutanota.com)),💌Email"
    # 国际常见广告
    - RULE-SET,category-ads-all_domain,🧹广告拦截
